# PostgreSQL
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10

# xAI Grok
XAI_API_KEY=your_xai_api_key_here
ENABLE_CHAT=false

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8000,http://localhost:8080,https://epro.zeabur.app
AUTO_MIGRATE=true
AUTO_SEED=true
SESSION_COOKIE_NAME=epro_admin_session
CSRF_COOKIE_NAME=epro_admin_csrf
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# First administrator (created only when no administrators exist; remove ADMIN_PASSWORD afterwards)
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Website Administrator
ADMIN_PASSWORD=

# Media storage (S3-compatible; local uploads are used in development when blank)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
